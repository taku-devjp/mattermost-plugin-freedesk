{
    "id": "com.freedesk.mattermost",
    "name": "Free Desk",
    "description": "Mattermost plugin for free desk (hot desk) reservations.",
    "homepage_url": "https://github.com/taku-devjp/mattermost-plugin-freedesk",
    "support_url": "https://github.com/taku-devjp/mattermost-plugin-freedesk/issues",
    "icon_path": "assets/freedesk-icon.svg",
    "min_server_version": "9.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "フリーデスク予約プラグインの設定",
        "footer": "",
        "settings": [
            {
                "key": "NotificationChannelID",
                "display_name": "通知チャンネル ID",
                "type": "text",
                "help_text": "予約・取消の通知を投稿するチャンネル ID。空の場合は通知しません。",
                "placeholder": "",
                "default": ""
            },
            {
                "key": "EnableNotifications",
                "display_name": "チャンネル通知を有効にする",
                "type": "bool",
                "help_text": "予約・取消時に通知チャンネルへ投稿します。",
                "default": true
            },
            {
                "key": "MaxAdvanceMonths",
                "display_name": "予約可能月数",
                "type": "number",
                "help_text": "今日から何か月先まで予約できるか（1〜6か月、デフォルト: 2か月）。",
                "default": 2
            },
            {
                "key": "OneDeskPerDay",
                "display_name": "1日1デスク制限",
                "type": "bool",
                "help_text": "同一ユーザーが同日に複数デスクを予約できないようにします。",
                "default": true
            },
            {
                "key": "PluginAdminUserIDs",
                "display_name": "プラグイン管理者ユーザー ID",
                "type": "text",
                "help_text": "管理タブ・デスク CRUD・代理取消が可能なユーザー ID（カンマ区切り）。",
                "placeholder": "",
                "default": ""
            }
        ]
    }
}
